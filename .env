# Banco de dados Supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://db.SEU_PROJETO_AQUI.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_DEFINIDA_NO_SUPABASE

# Hibernate valida o schema do Supabase sem tentar recriar tabelas
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Chave JWT (pode manter esta de 64 caracteres ou gerar outra)
AURORA_JWT_SECRET=9a6f8b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
AURORA_JWT_EXPIRATION_MS=1800000

# Porta do backend
PORT=8080
