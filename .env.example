# ==============================================================================
# Aurora - Variáveis de Ambiente de Exemplo
# ==============================================================================
# Renomeie ou copie este arquivo para .env localmente para configurar o Supabase.
# NUNCA commite senhas ou arquivos .env reais no controle de versão!

# Supabase PostgreSQL JDBC Connection (Direct 5432 ou Pooler 6543)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.[SEU_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_DO_BANCO_SUPABASE

# Hibernate / JPA
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Segurança JWT (30 minutos = 1800000 ms)
AURORA_JWT_SECRET=9a6f8b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
AURORA_JWT_EXPIRATION_MS=1800000

# Porta do Servidor Spring Boot
PORT=8080
